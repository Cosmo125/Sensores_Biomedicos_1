#define LOGO_WIDTH  64
#define LOGO_HEIGHT 24

void setup() {
  display.begin(SSD1306_SWITCHCAPVCC, 0x3C);
  display.clearDisplay();
  display.setTextColor(WHITE);
  display.setTextSize(1);

  // Texto centrado en la fila superior (y=0 a y=7)
  // "EMBS UTP" = 8 caracteres * 6px = 48px -> x = (128-48)/2 = 40
  display.setCursor(40, 0);
  display.print("EMBS UTP");

  // Logo centrado horizontalmente, justo debajo del texto (y=8 a y=31)
  // x = (128-64)/2 = 32
  display.drawBitmap(32, 8, logo_embs_utp, LOGO_WIDTH, LOGO_HEIGHT, WHITE);

  display.display();
}

void loop() {
  // estatico, nada que actualizar
}
